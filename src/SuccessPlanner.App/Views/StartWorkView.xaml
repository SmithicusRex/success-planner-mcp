<UserControl x:Class="SuccessPlanner.App.Views.StartWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="StartBrush" Color="#8DDAD5" />
        <SolidColorBrush x:Key="StartSoftBrush" Color="#E7F8F7" />
        <SolidColorBrush x:Key="StartInkBrush" Color="#186D69" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StartSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B7DEDB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D2F1EE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource StartSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B7DEDB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D2F1EE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskListVisibilityStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTaskOptions}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyStateVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTaskOptions}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskNotesVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNotes}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedFocusVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedTask}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggestionBadgeVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuggestedAction}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{StaticResource StartBrush}"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Padding="14,8"
                            CornerRadius="8"
                            Background="#E6F4EA"
                            BorderBrush="#CDEAD5"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#24984E"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#1E6B3A"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource RefreshButtonStyle}"
                            ToolTip="Refresh Start">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Refresh"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Focus Queue"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Current actions ready for a short focus block."
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource StartSoftBrush}"
                                BorderBrush="#B7DEDB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding TaskCountText}"
                                       Foreground="{StaticResource StartInkBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,20,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource TaskListVisibilityStyle}">
                        <ItemsControl ItemsSource="{Binding TaskOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="{Binding CardBorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,0,12"
                                            MinHeight="124"
                                            ToolTip="{Binding CardToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{Binding CardAccentColor}"
                                                    CornerRadius="4" />

                                            <Border Grid.Column="2"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="8"
                                                    Background="{Binding CardAccentColor}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding CardIconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="19"
                                                           Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource InkBrush}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding NotesPreview}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource TaskNotesVisibilityStyle}" />

                                                <WrapPanel Margin="0,12,0,0">
                                                    <Border Background="{Binding DueBadgeBackground}"
                                                            BorderBrush="#D8DDE5"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding DueText}"
                                                                   Foreground="{Binding DueBadgeForeground}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{Binding PriorityBadgeBackground}"
                                                            BorderBrush="#E7E2D8"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding PriorityBadgeText}"
                                                                   Foreground="{Binding PriorityBadgeForeground}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{Binding StatusBadgeBackground}"
                                                            BorderBrush="#E7E2D8"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   Foreground="{Binding StatusBadgeForeground}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{StaticResource StartSoftBrush}"
                                                            BorderBrush="#B7DEDB"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding FocusBadgeText}"
                                                                   Foreground="{StaticResource StartInkBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#FFF6D6"
                                                            BorderBrush="#E4CD75"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8"
                                                            Style="{StaticResource SuggestionBadgeVisibilityStyle}">
                                                        <TextBlock Text="{Binding SuggestionBadgeText}"
                                                                   Foreground="#765A00"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </WrapPanel>

                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FocusReasonText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding EstimateText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Command="{Binding SelectCommand}"
                                                            Style="{StaticResource CardActionButtonStyle}"
                                                            ToolTip="Select focus">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="Select"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="0,20,0,0"
                            Background="#F5F3EE"
                            BorderBrush="#E7E2D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="34"
                            Style="{StaticResource EmptyStateVisibilityStyle}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="8"
                                    Background="{StaticResource StartSoftBrush}"
                                    BorderBrush="#B7DEDB"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,18">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{StaticResource StartInkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EmptyStateText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="8"
                                    Background="{StaticResource StartBrush}"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusPanelTitle}"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SelectedTaskTitle}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="10"
                                CornerRadius="5"
                                Background="{StaticResource StartBrush}"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding FocusPanelText}"
                                   Style="{StaticResource QuietTextStyle}" />

                        <Border Background="{StaticResource StartSoftBrush}"
                                BorderBrush="#B7DEDB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,16,0,0"
                                Style="{StaticResource SelectedFocusVisibilityStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding PlannedMinutesText}"
                                           Foreground="{StaticResource StartInkBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FocusIntention}"
                                           Foreground="#355D5A"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="8"
                                        Background="#FFE08A"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE9D5;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{StaticResource InkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SuggestionPanelTitle}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SuggestionBadgeText}"
                                               Foreground="#765A00"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Height="10"
                                CornerRadius="5"
                                Background="#FFE08A"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding SuggestionPanelText}"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuggestionReasonText}"
                                   Style="{StaticResource QuietTextStyle}"
                                   Margin="0,8,0,0" />

                        <Button Command="{Binding UseSuggestionCommand}"
                                Style="{StaticResource CardActionButtonStyle}"
                                MinWidth="148"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="Use suggested action">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Use Suggestion"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Focus Rhythm"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#FFE08A"
                                Margin="0,4,0,16" />
                        <TextBlock Text="Twenty focused minutes, then a real break."
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

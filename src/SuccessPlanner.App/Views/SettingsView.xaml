<UserControl x:Class="SuccessPlanner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B8C0CC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E8EDF3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Settings"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Keep the control center personal, calm, and ready."
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SettingsFileStatus}"
                                   Foreground="#1E6B3A"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding SaveStatus}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="Profile name" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 Padding="10,8"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Default focus minutes" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding DefaultFocusMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 Padding="10,8"
                                 Margin="0,0,0,14" />

                        <CheckBox Content="Start sync when the app opens"
                                  IsChecked="{Binding StartSyncOnLaunch}"
                                  FontSize="15"
                                  Margin="0,0,0,14" />

                        <CheckBox Content="Use large controls"
                                  IsChecked="{Binding UseLargeControls}"
                                  FontSize="15" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Connections" Style="{StaticResource SectionTitleStyle}" />

                        <CheckBox Content="Microsoft To Do"
                                  IsChecked="{Binding EnableMicrosoftToDo}"
                                  FontSize="15"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="Planner"
                                  IsChecked="{Binding EnablePlanner}"
                                  FontSize="15"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="Project Desktop"
                                  IsChecked="{Binding EnableProjectDesktop}"
                                  FontSize="15"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="Phone Companion"
                                  IsChecked="{Binding EnablePhoneCompanion}"
                                  FontSize="15"
                                  Margin="0,0,0,18" />

                        <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 Padding="10,8"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Accent color" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 Padding="10,8" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Destination Rules" Style="{StaticResource SectionTitleStyle}" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DestinationRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F3EE"
                                        BorderBrush="#E7E2D8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Condition}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Destination}"
                                                   Foreground="#2F6FED"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="18,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Background="#2F6FED"
                                Foreground="#FFFFFF"
                                Style="{StaticResource SettingsButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

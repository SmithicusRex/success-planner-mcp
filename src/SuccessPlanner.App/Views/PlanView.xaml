<UserControl x:Class="SuccessPlanner.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="PlanBrush" Color="#FFE08A" />
        <SolidColorBrush x:Key="PlanSoftBrush" Color="#FFF6D6" />
        <SolidColorBrush x:Key="PlanInkBrush" Color="#765A00" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#ECF8EE" />
        <SolidColorBrush x:Key="RoseSoftBrush" Color="#FFF0F0" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StateLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="StateValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E1D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="138" />
        </Style>

        <Style x:Key="PlanActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PlanSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4CD75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8E7AA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanInboxCardButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="118" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PlanSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4CD75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8E7AA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InboxListVisibilityStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasInboxItems}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyStateVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasInboxItems}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNotes}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{Binding AccentColor}"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Padding="14,8"
                            CornerRadius="8"
                            Background="#E6F4EA"
                            BorderBrush="#CDEAD5"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#24984E"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#1E6B3A"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource PlanActionButtonStyle}"
                            ToolTip="Refresh Plan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Refresh"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding PlanPanelTitle}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding PlanPanelText}"
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource PlanSoftBrush}"
                                BorderBrush="#E4CD75"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Top"
                                Margin="18,0,0,0">
                            <TextBlock Text="{Binding InboxCountText}"
                                       Foreground="{StaticResource PlanInkBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource PlanSoftBrush}"
                            BorderBrush="#E4CD75"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="64"
                                    Height="64"
                                    CornerRadius="8"
                                    Background="{StaticResource PlanBrush}">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="28"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Inbox"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmptyStateText}"
                                           Foreground="{StaticResource PlanInkBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource InboxListVisibilityStyle}">
                        <ItemsControl ItemsSource="{Binding InboxItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}"
                                            BorderBrush="{Binding CardBorderColor}"
                                            Background="#FFFFFF"
                                            Style="{StaticResource PlanInboxCardButtonStyle}"
                                            ToolTip="{Binding CardToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{Binding CardAccentColor}"
                                                    CornerRadius="4" />

                                            <Border Grid.Column="2"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="8"
                                                    Background="{Binding CardAccentColor}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding CardIconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="19"
                                                           Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource InkBrush}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding NotesPreview}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource NotesVisibilityStyle}" />

                                                <WrapPanel Margin="0,12,0,0">
                                                    <Border Background="{Binding PriorityBadgeBackground}"
                                                            BorderBrush="#E7E2D8"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding PriorityBadgeText}"
                                                                   Foreground="{Binding PriorityBadgeForeground}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{Binding StatusBadgeBackground}"
                                                            BorderBrush="#E7E2D8"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   Foreground="{Binding StatusBadgeForeground}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="#F5F3EE"
                                                            BorderBrush="#E7E2D8"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,5"
                                                            Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding CreatedText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,18,0,0"
                            Background="#F5F3EE"
                            BorderBrush="#E7E2D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="34"
                            Style="{StaticResource EmptyStateVisibilityStyle}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="8"
                                    Background="{StaticResource PlanSoftBrush}"
                                    BorderBrush="#E4CD75"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,18">
                                <TextBlock Text="&#xE9D5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{StaticResource PlanInkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EmptyStateText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="3"
                                 Columns="3"
                                 Margin="0,18,0,0">
                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#E4CD75"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource PlanSoftBrush}"
                                        BorderBrush="#E4CD75"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8A5;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{StaticResource PlanInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Inbox"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding InboxStatusText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#B7D8FF"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource BlueSoftBrush}"
                                        BorderBrush="#B7D8FF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8D4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#245EC9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Selected"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding SelectedInboxItemText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#CDEAD5">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource GreenSoftBrush}"
                                        BorderBrush="#CDEAD5"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#1E6B3A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Minimum Win"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding MinimumWinText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#E5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22"
                            IsEnabled="{Binding HasSelectedInboxItem}">
                        <StackPanel>
                            <TextBlock Text="Plan Controls"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <Border Height="10"
                                    CornerRadius="5"
                                    Background="{StaticResource PlanBrush}"
                                    Margin="0,4,0,16" />

                            <TextBlock Text="Priority"
                                       Style="{StaticResource StateLabelStyle}" />
                            <UniformGrid Columns="2"
                                         Margin="0,0,0,12">
                                <Button Command="{Binding ChooseLowPriorityCommand}"
                                        Content="Low"
                                        Margin="0,0,8,8"
                                        ToolTip="Low priority">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlanActionButtonStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowPrioritySelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BlueSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="#9DCCFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ChooseNormalPriorityCommand}"
                                        Content="Normal"
                                        Margin="0,0,0,8"
                                        ToolTip="Normal priority">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlanActionButtonStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNormalPrioritySelected}" Value="True">
                                                    <Setter Property="Background" Value="#F5F3EE" />
                                                    <Setter Property="BorderBrush" Value="#B8C0CC" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ChooseHighPriorityCommand}"
                                        Content="High"
                                        Margin="0,0,8,0"
                                        ToolTip="High priority">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlanActionButtonStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighPrioritySelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PlanBrush}" />
                                                    <Setter Property="BorderBrush" Value="#E4CD75" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ChooseCriticalPriorityCommand}"
                                        Content="Critical"
                                        ToolTip="Critical priority">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlanActionButtonStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCriticalPrioritySelected}" Value="True">
                                                    <Setter Property="Background" Value="#F8A8A8" />
                                                    <Setter Property="BorderBrush" Value="#EAB1B1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="Date"
                                       Style="{StaticResource StateLabelStyle}" />
                            <UniformGrid Columns="2"
                                         Margin="0,0,0,12">
                                <Button Command="{Binding ClearDateCommand}"
                                        Content="No Date"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="0"
                                        Margin="0,0,8,8"
                                        ToolTip="No plan date" />
                                <Button Command="{Binding TodayDateCommand}"
                                        Content="Today"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="0"
                                        Margin="0,0,0,8"
                                        ToolTip="Plan for today" />
                                <Button Command="{Binding TomorrowDateCommand}"
                                        Content="Tomorrow"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="0"
                                        Margin="0,0,8,0"
                                        ToolTip="Plan for tomorrow" />
                                <Button Command="{Binding ThisWeekDateCommand}"
                                        Content="This Week"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="0"
                                        ToolTip="Plan for this week" />
                            </UniformGrid>

                            <TextBlock Text="Project"
                                       Style="{StaticResource StateLabelStyle}" />
                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlanTextBoxStyle}"
                                     Margin="0,0,0,12"
                                     ToolTip="Project name" />

                            <TextBlock Text="Minimum Win"
                                       Style="{StaticResource StateLabelStyle}" />
                            <TextBox Text="{Binding MinimumWinDraft, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlanTextBoxStyle}"
                                     AcceptsReturn="True"
                                     MinHeight="74"
                                     VerticalContentAlignment="Top"
                                     ToolTip="Minimum win" />

                            <TextBlock Text="Tiny Steps"
                                       Style="{StaticResource StateLabelStyle}"
                                       Margin="0,14,0,6" />
                            <Button Command="{Binding SplitIntoTinyStepsCommand}"
                                    Style="{StaticResource PlanActionButtonStyle}"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Create tiny steps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Create Tiny Steps"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding TinyStepDraft, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PlanTextBoxStyle}"
                                         ToolTip="Custom tiny step" />
                                <Button Grid.Column="2"
                                        Command="{Binding AddTinyStepCommand}"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="74"
                                        Content="Add"
                                        ToolTip="Add tiny step" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding TinyStepsText}"
                                           Style="{StaticResource QuietTextStyle}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding ClearTinyStepsCommand}"
                                        Style="{StaticResource PlanActionButtonStyle}"
                                        MinWidth="74"
                                        Height="34"
                                        Content="Clear"
                                        ToolTip="Clear tiny steps" />
                            </Grid>
                            <TextBlock Text="{Binding TinyStepStatusText}"
                                       Foreground="{StaticResource PlanInkBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <ItemsControl ItemsSource="{Binding TinySteps}"
                                          Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF"
                                                BorderBrush="{Binding CardBorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                ToolTip="{Binding CardToolTip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="8"
                                                        Background="{Binding CardAccentColor}">
                                                    <TextBlock Text="{Binding CardIconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="15"
                                                               Foreground="{StaticResource InkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               Foreground="#1E6B3A"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource InkBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="4"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource PlanActionButtonStyle}"
                                                        MinWidth="42"
                                                        Width="42"
                                                        Height="34"
                                                        Padding="0"
                                                        ToolTip="Remove tiny step">
                                                    <TextBlock Text="&#xE74D;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#E5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Planning Status"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <Border Height="10"
                                    CornerRadius="5"
                                    Background="{StaticResource PlanBrush}"
                                    Margin="0,4,0,16" />
                            <TextBlock Text="{Binding PlanningStatusText}"
                                       Style="{StaticResource QuietTextStyle}" />
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="{Binding PriorityText}"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DateHintText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding ProjectText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#E5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Plan Draft"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <Border Height="10"
                                    CornerRadius="5"
                                    Background="#9DCCFF"
                                    Margin="0,4,0,16" />
                            <TextBlock Text="{Binding SaveStatusText}"
                                       Style="{StaticResource QuietTextStyle}" />
                            <Border Background="{StaticResource RoseSoftBrush}"
                                    BorderBrush="#F3CACA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="8"
                                            Background="#FFFFFF"
                                            BorderBrush="#F3CACA"
                                            BorderThickness="1">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#8A3434"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MinimumWinText}"
                                               Foreground="#8A3434"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

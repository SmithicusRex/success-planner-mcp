<UserControl x:Class="SuccessPlanner.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="PlanBrush" Color="#FFE08A" />
        <SolidColorBrush x:Key="PlanSoftBrush" Color="#FFF6D6" />
        <SolidColorBrush x:Key="PlanInkBrush" Color="#765A00" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#ECF8EE" />
        <SolidColorBrush x:Key="RoseSoftBrush" Color="#FFF0F0" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StateLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="StateValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E1D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="138" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{Binding AccentColor}"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="8"
                        Background="#E6F4EA"
                        BorderBrush="#CDEAD5"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#24984E"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#1E6B3A"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding PlanPanelTitle}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding PlanPanelText}"
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource PlanSoftBrush}"
                                BorderBrush="#E4CD75"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Top"
                                Margin="18,0,0,0">
                            <TextBlock Text="{Binding InboxCountText}"
                                       Foreground="{StaticResource PlanInkBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource PlanSoftBrush}"
                            BorderBrush="#E4CD75"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="8"
                                    Background="{StaticResource PlanBrush}">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Inbox"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmptyStateText}"
                                           Foreground="{StaticResource PlanInkBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Margin="0,18,0,0">
                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#E4CD75"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource PlanSoftBrush}"
                                        BorderBrush="#E4CD75"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8A5;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{StaticResource PlanInkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Inbox"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding InboxStatusText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#B7D8FF"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource BlueSoftBrush}"
                                        BorderBrush="#B7D8FF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8D4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#245EC9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Selected"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding SelectedInboxItemText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusCardStyle}"
                                BorderBrush="#CDEAD5">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource GreenSoftBrush}"
                                        BorderBrush="#CDEAD5"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#1E6B3A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Minimum Win"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding MinimumWinText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Planning Status"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="{StaticResource PlanBrush}"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding PlanningStatusText}"
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Local Status"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#A8E6B1"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding SaveStatusText}"
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Plan Draft"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#9DCCFF"
                                Margin="0,4,0,16" />
                        <Border Background="{StaticResource RoseSoftBrush}"
                                BorderBrush="#F3CACA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="8"
                                        Background="#FFFFFF"
                                        BorderBrush="#F3CACA"
                                        BorderThickness="1">
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#8A3434"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding EmptyStateText}"
                                           Foreground="#8A3434"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

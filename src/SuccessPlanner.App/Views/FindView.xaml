<UserControl x:Class="SuccessPlanner.App.Views.FindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="FindBrush" Color="#D6E8FF" />
        <SolidColorBrush x:Key="FindSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="FindInkBrush" Color="#245EC9" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#E6F4EA" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FindTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#B7D8FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CaretBrush" Value="#2F6FED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FindButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FindSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#92C5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D9ECFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryFindButtonStyle" TargetType="Button" BasedOn="{StaticResource FindButtonStyle}">
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="BorderBrush" Value="#245EC9" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SmallFindButtonStyle" TargetType="Button" BasedOn="{StaticResource FindButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ResultsListVisibilityStyle" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResults}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyResultsVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasResults}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OpenedItemVisibilityStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOpenedItem}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoOpenedItemVisibilityStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOpenedItem}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{StaticResource FindBrush}"
                            BorderBrush="#B7D8FF"
                            BorderThickness="1"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource FindInkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="8"
                        Background="{StaticResource GreenSoftBrush}"
                        BorderBrush="#CDEAD5"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#24984E"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#1E6B3A"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SearchPanelTitle}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding SearchPanelText}"
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource FindSoftBrush}"
                            BorderBrush="#B7D8FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Search"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FindTextBoxStyle}"
                                         MaxLength="180" />

                                <Button Grid.Column="2"
                                        Command="{Binding SearchCommand}"
                                        Style="{StaticResource PrimaryFindButtonStyle}"
                                        ToolTip="Search">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Search"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4"
                                        Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource FindButtonStyle}"
                                        ToolTip="Clear search">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE894;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Clear"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#E5E1D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Results"
                                           Style="{StaticResource SectionTitleStyle}" />

                                <Border Grid.Column="1"
                                        Background="{StaticResource FindSoftBrush}"
                                        BorderBrush="#B7D8FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ResultsCountText}"
                                               Foreground="{StaticResource FindInkBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Results}"
                                              Style="{StaticResource ResultsListVisibilityStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackgroundColor}"
                                                    BorderBrush="{Binding CardBorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16"
                                                    Margin="0,0,0,10"
                                                    ToolTip="{Binding CardToolTip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42"
                                                            Height="42"
                                                            CornerRadius="8"
                                                            Background="{Binding CardAccentColor}"
                                                            BorderBrush="{Binding CardBorderColor}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding CardIconGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="17"
                                                                   Foreground="{StaticResource InkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource InkBrush}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Border Grid.Column="3"
                                                            VerticalAlignment="Top"
                                                            Margin="14,0,0,0">
                                                        <StackPanel>
                                                            <Border Background="#FFFFFF"
                                                                    BorderBrush="{Binding CardBorderColor}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="10,7"
                                                                    HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding BadgeText}"
                                                                           Foreground="{StaticResource FindInkBrush}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Button Command="{Binding OpenCommand}"
                                                                    Style="{StaticResource SmallFindButtonStyle}"
                                                                    ToolTip="Open local item"
                                                                    Margin="0,10,0,0"
                                                                    HorizontalAlignment="Right">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE8A7;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13"
                                                                               Margin="0,0,7,0"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding OpenButtonText}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#F7FAFF"
                                        BorderBrush="#D8E9FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="28"
                                        Style="{StaticResource EmptyResultsVisibilityStyle}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="66"
                                                Height="66"
                                                CornerRadius="8"
                                                Background="{StaticResource FindBrush}"
                                                BorderBrush="#B7D8FF"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,14">
                                            <TextBlock Text="&#xE721;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="27"
                                                       Foreground="{StaticResource FindInkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding EmptyStateText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="420" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="{Binding OpenedItemPanelTitle}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="{Binding OpenedResult.CardAccentColor, FallbackValue=#D6E8FF}"
                                Margin="0,4,0,16" />

                        <StackPanel Style="{StaticResource NoOpenedItemVisibilityStyle}">
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="8"
                                    Background="{StaticResource FindBrush}"
                                    BorderBrush="#B7D8FF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14">
                                <TextBlock Text="&#xE8A7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="21"
                                           Foreground="{StaticResource FindInkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding OpenedItemPanelText}"
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource OpenedItemVisibilityStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="8"
                                        Background="{Binding OpenedResult.CardAccentColor}"
                                        BorderBrush="{Binding OpenedResult.CardBorderColor}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding OpenedResult.CardIconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="19"
                                               Foreground="{StaticResource InkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OpenedResult.Title}"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OpenedResult.BadgeText}"
                                               Foreground="{StaticResource FindInkBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding OpenedResult.Detail}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />

                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E1D8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Local Source"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OpenedResult.SourceText}"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E1D8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Local ID"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OpenedResult.LocalIdText}"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Search Status"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#FFE08A"
                                Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Background="#FFF6D6"
                                    BorderBrush="#E4CD75"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="#765A00"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ResultsCountText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

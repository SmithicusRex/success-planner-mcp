<UserControl x:Class="SuccessPlanner.App.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="ReviewBrush" Color="#C8B6FF" />
        <SolidColorBrush x:Key="ReviewSoftBrush" Color="#F0ECFF" />
        <SolidColorBrush x:Key="ReviewInkBrush" Color="#473377" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#ECF8EE" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="RoseSoftBrush" Color="#FFF0F0" />
        <SolidColorBrush x:Key="GoldSoftBrush" Color="#FFF6D6" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StateLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="StateValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ReviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E1D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="154" />
        </Style>

        <Style x:Key="ReviewActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DADF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ReviewSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B8A2F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DFD6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallWinListVisibilityStyle" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSmallWins}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{Binding AccentColor}"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="8"
                        Background="#E6F4EA"
                        BorderBrush="#CDEAD5"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#24984E"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#1E6B3A"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ReviewPanelTitle}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding ReviewPanelText}"
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource ReviewSoftBrush}"
                                BorderBrush="#B8A2F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Top"
                                Margin="18,0,0,0">
                            <TextBlock Text="{Binding ReviewCountText}"
                                       Foreground="{StaticResource ReviewInkBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource ReviewSoftBrush}"
                            BorderBrush="#B8A2F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="64"
                                    Height="64"
                                    CornerRadius="8"
                                    Background="{StaticResource ReviewBrush}">
                                <TextBlock Text="&#xE9D2;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="28"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Week Summary"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeekSummaryText}"
                                           Foreground="{StaticResource ReviewInkBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding EmptyStateText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Margin="0,18,0,0">
                        <Border Style="{StaticResource ReviewCardStyle}"
                                BorderBrush="#CDEAD5"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource GreenSoftBrush}"
                                        BorderBrush="#CDEAD5"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#1E6B3A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Small Wins"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding SmallWinsText}"
                                           Style="{StaticResource StateValueStyle}" />
                                <ItemsControl ItemsSource="{Binding SmallWins}"
                                              Margin="0,14,0,0"
                                              Style="{StaticResource SmallWinListVisibilityStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12"
                                                  ToolTip="{Binding CardToolTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="8"
                                                        Background="{Binding CardAccentColor}">
                                                    <TextBlock Text="{Binding CardIconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{StaticResource InkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Text}"
                                                               Foreground="{StaticResource InkBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <WrapPanel Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding SourceText}"
                                                                   Foreground="#1E6B3A"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding CreatedText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ReviewCardStyle}"
                                BorderBrush="#F3CACA"
                                Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource RoseSoftBrush}"
                                        BorderBrush="#F3CACA"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#8A3434"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Stuck"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding StuckItemsText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ReviewCardStyle}"
                                BorderBrush="#B7D8FF">
                            <StackPanel>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="8"
                                        Background="{StaticResource BlueSoftBrush}"
                                        BorderBrush="#B7D8FF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE9CE;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#245EC9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Needs Decision"
                                           Style="{StaticResource StateLabelStyle}" />
                                <TextBlock Text="{Binding NeedsDecisionText}"
                                           Style="{StaticResource StateValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Next Focus"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="{StaticResource ReviewBrush}"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding NextFocusText}"
                                   Style="{StaticResource QuietTextStyle}" />
                        <TextBlock Text="{Binding SaveReviewStatusText}"
                                   Foreground="{StaticResource ReviewInkBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <Button Style="{StaticResource ReviewActionButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                Margin="0,16,0,0"
                                IsEnabled="{Binding CanSaveReview}"
                                ToolTip="Save review">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Save Review"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Review Status"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="{StaticResource GoldSoftBrush}"
                                Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Background="{StaticResource GoldSoftBrush}"
                                    BorderBrush="#E4CD75"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="#765A00"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReviewCountText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="SuccessPlanner.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#171717" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F656C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF7" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF4FF" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="QuietTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CaptureTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#B7D8FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CaretBrush" Value="#2F6FED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChoiceButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F7FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#92C5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D9ECFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="BorderBrush" Value="#245EC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#245EC9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1C4FAF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#E5E1D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{Binding AccentColor}"
                            Margin="0,0,18,0">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="8"
                        Background="#E6F4EA"
                        BorderBrush="#CDEAD5"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#24984E"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#1E6B3A"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="#E5E1D8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Quick Capture"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Text="One calm place for the next useful thought."
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,24,0,0"
                            Background="{StaticResource SoftBlueBrush}"
                            BorderBrush="#CFE5FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Task title"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TaskTitleTextBox"
                                         Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CaptureTextBoxStyle}"
                                         MaxLength="180" />
                                <TextBlock Text="{Binding ValidationMessage}"
                                           Foreground="#A9402D"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           MinHeight="22"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,18,0,0">
                                <Button Command="{Binding SaveTaskCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Save"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Date Hint"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#FFE08A"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding DateHintText}"
                                   Style="{StaticResource QuietTextStyle}" />
                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Today"
                                    Command="{Binding TodayDateCommand}"
                                    Style="{StaticResource ChoiceButtonStyle}" />
                            <Button Content="Tomorrow"
                                    Command="{Binding TomorrowDateCommand}"
                                    Style="{StaticResource ChoiceButtonStyle}" />
                            <Button Content="This Week"
                                    Command="{Binding ThisWeekDateCommand}"
                                    Style="{StaticResource ChoiceButtonStyle}" />
                            <Button Content="No Date"
                                    Command="{Binding ClearDateCommand}"
                                    Style="{StaticResource ChoiceButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#E5E1D8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Destination"
                                   Style="{StaticResource PanelTitleStyle}" />
                        <Border Height="10"
                                CornerRadius="5"
                                Background="#A8E6B1"
                                Margin="0,4,0,16" />
                        <TextBlock Text="{Binding DestinationHintText}"
                                   Style="{StaticResource QuietTextStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Margin="0,18,0,0">
                            <WrapPanel>
                                <Button Content="Let MCP Choose"
                                        Command="{Binding LetMcpChooseDestinationCommand}"
                                        MinWidth="150"
                                        Style="{StaticResource ChoiceButtonStyle}" />
                                <Button Content="Local"
                                        Command="{Binding LocalInboxDestinationCommand}"
                                        Style="{StaticResource ChoiceButtonStyle}" />
                                <Button Content="To Do"
                                        Command="{Binding MicrosoftToDoDestinationCommand}"
                                        Style="{StaticResource ChoiceButtonStyle}" />
                                <Button Content="Planner"
                                        Command="{Binding MicrosoftPlannerDestinationCommand}"
                                        Style="{StaticResource ChoiceButtonStyle}" />
                                <Button Content="Project"
                                        Command="{Binding MicrosoftProjectDestinationCommand}"
                                        Style="{StaticResource ChoiceButtonStyle}" />
                            </WrapPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SuccessPlanner.App</AssemblyName>
    <RootNamespace>SuccessPlanner.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\success-planner-mcp.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icons\success-planner-mcp.ico" Link="Assets\success-planner-mcp.ico" />
  </ItemGroup>
</Project>
